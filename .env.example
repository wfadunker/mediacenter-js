# Jalankan tanpa MySQL menggunakan data JSON lokal.
DB_MODE=json

# Digunakan hanya jika DB_MODE=mysql.
# Untuk database cloud (mis. TiDB Cloud Serverless) isi DB_SSL=true.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=mediacenter_user
DB_PASSWORD=GANTI_DENGAN_PASSWORD_DATABASE
DB_NAME=mediacenter_demo
DB_SSL=false
# Batasi koneksi per instance saat deploy serverless (mis. Vercel: 3).
DB_POOL_SIZE=10

PORT=3000
# Isi dengan secret acak minimal 32 byte sebelum production.
SESSION_SECRET=
NODE_ENV=development
