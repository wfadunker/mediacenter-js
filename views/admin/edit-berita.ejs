<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light">
    <meta name="robots" content="noindex, nofollow, noarchive">
    <title>Edit Berita - Media Center HST</title>
    <link rel="icon" type="image/png" href="<%= baseUrl %>/assets/img/favicon-hst.png">
    <link rel="stylesheet" href="<%= baseUrl %>/assets/css/admin.css?v=211">
</head>
<body class="admin-page" data-session-idle-at="<%= sessionIdleAt %>" data-session-max-at="<%= sessionMaxAt %>" data-session-login="<%= adminBase %>">
<a class="skip-link" href="#admin-main">Lewati ke konten utama</a>

<div class="admin-layout">
    <%- include('../partials/sidebar') %>

    <div class="admin-main">
        <%- include('../partials/admin-topbar') %>

        <main id="admin-main" class="admin-content" tabindex="-1">
            <section class="page-heading">
                <div>
                    <p class="eyebrow">Pengelolaan Berita</p>
                    <h1>Edit Berita</h1>
                    <p>Perbarui isi, metadata, dan gambar berita yang sudah dipublikasikan.</p>
                </div>
                <div class="page-heading__actions">
                    <a class="btn" href="<%= baseUrl %>/detail?slug=<%= encodeURIComponent(data.slug) %>" target="_blank" rel="noopener noreferrer">
                        Lihat Berita
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7"/><path d="M9 7h8v8"/></svg>
                    </a>
                    <a class="btn" href="<%= adminBase %>/berita">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5"/><path d="m11 18-6-6 6-6"/></svg>
                        Kembali
                    </a>
                </div>
            </section>

            <% if (errors.length) { %>
                <div class="alert alert--error" role="alert">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg>
                    <div>
                        <strong>Data belum dapat disimpan.</strong>
                        <ul class="alert__list"><% for (const error of errors) { %><li><%= error %></li><% } %></ul>
                    </div>
                </div>
            <% } %>

            <form method="post" enctype="multipart/form-data" class="editor-grid" data-editor-form>
                <input type="hidden" name="csrf_token" value="<%= csrfToken %>">

                <div class="editor-main">
                    <section class="panel">
                        <div class="panel__head">
                            <div>
                                <h2 class="panel__title">Isi Berita</h2>
                                <p class="panel__desc">Perbarui judul dan isi berita yang ditampilkan kepada masyarakat.</p>
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="form-label" for="judul">Judul Berita <span class="required">*</span></label>
                            <input id="judul" type="text" name="judul" value="<%= data.judul %>" required minlength="3" maxlength="255" class="form-control">
                        </div>

                        <div class="form-group">
                            <label class="form-label" for="isi">Isi Berita <span class="required">*</span></label>
                            <textarea id="isi" name="isi" required minlength="10" maxlength="100000" rows="14" class="form-control"><%= data.isi %></textarea>
                            <p class="form-help">Tekan Enter untuk membuat paragraf baru.</p>
                        </div>
                    </section>

                    <section class="panel">
                        <div class="panel__head">
                            <div>
                                <h2 class="panel__title">Informasi Publikasi</h2>
                                <p class="panel__desc">Metadata ini tampil sebagai informasi pendukung pada halaman berita.</p>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label class="form-label" for="kategori">Kategori <span class="required">*</span></label>
                                <input id="kategori" type="text" name="kategori" list="kategori-list" value="<%= data.kategori %>" required maxlength="100" class="form-control">
                                <datalist id="kategori-list">
                                    <option value="Pemerintahan">
                                    <option value="Pelayanan Publik">
                                    <option value="Pendidikan">
                                    <option value="Sosial">
                                    <option value="Keagamaan">
                                    <option value="Informasi">
                                    <option value="Komunikasi">
                                    <option value="Teknologi">
                                    <option value="Agenda">
                                </datalist>
                            </div>

                            <div class="form-group">
                                <label class="form-label" for="tanggal">Tanggal Publikasi <span class="required">*</span></label>
                                <input id="tanggal" type="date" name="tanggal" value="<%= data.tanggal %>" max="<%= todayIso() %>" required class="form-control">
                                <p class="form-help">Tanggal mengikuti zona waktu WITA dan tidak boleh melewati hari ini.</p>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label class="form-label" for="penulis">Penulis</label>
                                <input id="penulis" type="text" name="penulis" value="<%= data.penulis||'Media Center HST' %>" maxlength="150" class="form-control">
                            </div>

                            <div class="form-group">
                                <label class="form-label" for="sumber">Sumber</label>
                                <input id="sumber" type="text" name="sumber" value="<%= data.sumber||'Diskominfo HST' %>" maxlength="255" class="form-control">
                            </div>
                        </div>
                    </section>
                </div>

                <aside class="editor-side">
                    <section class="panel">
                        <div class="panel__head">
                            <div>
                                <h2 class="panel__title">Gambar Berita</h2>
                                <p class="panel__desc">Gambar utama yang tampil pada halaman publik.</p>
                            </div>
                        </div>

                        <% const existingImage=gambarUrl(data.gambar); %>
                        <div class="image-mode" role="radiogroup" aria-label="Sumber gambar">
                            <label>
                                <input type="radio" name="sumber_gambar" value="upload" checked data-image-mode="upload">
                                <span>Unggah file</span>
                            </label>
                            <label>
                                <input type="radio" name="sumber_gambar" value="url" data-image-mode="url">
                                <span>Tautan (URL)</span>
                            </label>
                        </div>

                        <div data-image-pane="upload">
                            <div class="image-preview" data-image-preview>
                                <span class="image-empty" data-image-empty <%= existingImage?'hidden':'' %>>
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="9" r="1.5"/><path d="m5 17 4-4 3 3 2-2 5 5"/></svg>
                                    Belum ada gambar
                                </span>
                                <img src="<%= existingImage %>" alt="Gambar berita saat ini" data-image-preview-img <%= existingImage?'':'hidden' %>>
                            </div>

                            <% if (data.gambar) { %>
                                <label class="check-row">
                                    <input type="checkbox" name="hapus_gambar" value="1">
                                    <span>Hapus gambar saat disimpan</span>
                                </label>
                            <% } %>

                            <input id="gambar" type="file" name="gambar" accept=".jpg,.jpeg,.png,.webp" class="file-input" data-image-input>
                            <p class="form-help">JPG, PNG, atau WebP. Maksimal 2 MB. Kosongkan jika tidak ingin mengganti gambar.</p>
                        </div>

                        <div data-image-pane="url" hidden>
                            <label class="form-label" for="gambar_url">URL gambar</label>
                            <div class="image-url-row">
                                <input id="gambar_url" type="url" name="gambar_url" class="form-control" maxlength="2048"
                                       inputmode="url" spellcheck="false" placeholder="https://contoh.go.id/foto-kegiatan.jpg">
                                <button type="button" class="btn btn--sm" data-image-url-check="<%= adminBase %>/gambar-pratinjau">Periksa</button>
                            </div>
                            <div class="image-preview image-preview--url" data-image-url-box hidden>
                                <img src="" alt="Pratinjau gambar dari tautan" data-image-url-preview>
                            </div>
                            <p class="image-url-msg" data-image-url-msg hidden></p>
                            <p class="form-help">Gambar akan diunduh dan disimpan ke server saat berita disimpan. JPG, PNG, atau WebP, maksimal 2 MB.</p>
                        </div>
                    </section>

                    <section class="panel">
                        <div class="panel__head">
                            <div>
                                <h2 class="panel__title">Informasi Berita</h2>
                                <p class="panel__desc">Detail teknis publikasi.</p>
                            </div>
                        </div>

                        <div class="meta-list">
                            <div class="meta-row"><span>ID</span><strong>#<%= data.id %></strong></div>
                            <div class="meta-row"><span>Slug</span><strong class="meta-slug"><%= data.slug %></strong></div>
                            <div class="meta-row"><span>Terakhir update</span><strong><%= waktuAdmin(data.updated_at) %></strong></div>
                        </div>

                        <button type="submit" class="btn btn--primary btn--block" data-submit>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg>
                            Simpan Perubahan
                        </button>
                    </section>
                </aside>
            </form>
        </main>
    </div>
</div>

<script src="<%= baseUrl %>/assets/js/admin.js" defer></script>
</body>
</html>
