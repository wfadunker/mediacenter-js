<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light">
    <meta name="robots" content="noindex, nofollow, noarchive">
    <title>Dashboard - Media Center HST</title>
    <link rel="icon" type="image/png" href="<%= baseUrl %>/assets/img/favicon-hst.png">
    <link rel="stylesheet" href="<%= baseUrl %>/assets/css/admin.css?v=211">
</head>
<body class="admin-page" data-session-idle-at="<%= sessionIdleAt %>" data-session-max-at="<%= sessionMaxAt %>" data-session-login="<%= adminBase %>">
<a class="skip-link" href="#admin-main">Lewati ke konten utama</a>

<div class="admin-layout">
    <%- include('../partials/sidebar') %>

    <div class="admin-main">
        <%- include('../partials/admin-topbar') %>

        <main id="admin-main" class="admin-content" tabindex="-1">
            <section class="page-heading">
                <div>
                    <p class="eyebrow">Ringkasan</p>
                    <h1>Selamat datang, <%= username %>.</h1>
                    <p><%= tanggalFull %> &middot; <strong><%= jamFull %></strong>. Semua yang perlu Anda kelola ada di sini.</p>
                </div>
                <div class="page-heading__actions">
                    <a class="btn" href="<%= adminBase %>/berita">Kelola Berita</a>
                    <a class="btn btn--primary" href="<%= adminBase %>/berita/tambah">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                        Tambah Berita
                    </a>
                </div>
            </section>

            <% if (isDeleted) { %>
                <div class="alert alert--success" role="status">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg>
                    <span>Berita berhasil dihapus.</span>
                </div>
            <% } %>

            <section class="stat-grid" aria-label="Ringkasan konten">
                <article class="stat">
                    <span class="stat__icon stat__icon--navy">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h10l4 4v12H5z"/><path d="M15 4v5h4"/><path d="M8 13h8M8 16h6"/></svg>
                    </span>
                    <span class="stat__value"><%= numberFormat(totalBerita) %></span>
                    <span class="stat__label">Total Berita</span>
                    <span class="stat__meta">Seluruh publikasi tersimpan</span>
                </article>

                <article class="stat">
                    <span class="stat__icon stat__icon--teal">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="4" width="6" height="6" rx="1.5"/><rect x="14" y="4" width="6" height="6" rx="1.5"/><rect x="4" y="14" width="6" height="6" rx="1.5"/><rect x="14" y="14" width="6" height="6" rx="1.5"/></svg>
                    </span>
                    <span class="stat__value"><%= numberFormat(totalKategori) %></span>
                    <span class="stat__label">Kategori</span>
                    <span class="stat__meta">Pengelompokan konten aktif</span>
                </article>

                <article class="stat">
                    <span class="stat__icon stat__icon--gold">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="9" r="1.5"/><path d="m5 17 4-4 3 3 2-2 5 5"/></svg>
                    </span>
                    <span class="stat__value"><%= numberFormat(totalGambar) %></span>
                    <span class="stat__label">Berita Bergambar</span>
                    <span class="stat__meta"><%= persenGambar %>% dari total berita</span>
                </article>

                <article class="stat">
                    <span class="stat__icon stat__icon--slate">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                    </span>
                    <span class="stat__value stat__value--small"><%= updateTerakhir %></span>
                    <span class="stat__label">Update Terakhir</span>
                    <span class="stat__meta">Waktu perubahan terakhir</span>
                </article>
            </section>

            <section class="dashboard-grid">
                <article class="panel">
                    <div class="panel__head">
                        <div>
                            <h2 class="panel__title">Aktivitas 7 Hari Terakhir</h2>
                            <p class="panel__desc">Jumlah berita yang dipublikasikan setiap hari.</p>
                        </div>
                        <span class="pill pill--soft"><%= persenGambar %>% bergambar</span>
                    </div>

                    <div class="chart" role="img" aria-label="Grafik aktivitas publikasi tujuh hari terakhir">
                        <% for (const [i,d] of chartData.entries()) { const h=Math.max(8,100*d.count/chartMax) %>
                            <div class="chart__col">
                                <div class="chart__track">
                                    <div class="chart__bar" style="--h: <%= h %>%; animation-delay: <%= i*0.05 %>s">
                                        <span class="chart__value"><%= d.count %></span>
                                    </div>
                                </div>
                                <span class="chart__label"><%= dayName(d.date) %></span>
                            </div>
                        <% } %>
                    </div>
                </article>

                <article class="panel">
                    <div class="panel__head">
                        <div>
                            <h2 class="panel__title">Berita Terbaru</h2>
                            <p class="panel__desc">Lima konten terakhir yang diperbarui.</p>
                        </div>
                        <a class="panel__link" href="<%= adminBase %>/berita">Lihat semua</a>
                    </div>

                    <% if (latestRows.length) { %>
                        <div class="news-list">
                            <% for (const row of latestRows) { const thumb=gambarUrl(row.gambar); %>
                                <a class="news-row" href="<%= adminBase %>/berita/edit?id=<%= row.id %>">
                                    <span class="news-row__thumb">
                                        <% if (thumb) { %>
                                            <img src="<%= thumb %>" alt="" loading="lazy" decoding="async">
                                        <% } else { %>
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h10l4 4v12H5z"/><path d="M15 4v5h4"/><path d="M8 13h8M8 16h6"/></svg>
                                        <% } %>
                                    </span>
                                    <span class="news-row__body">
                                        <span class="badge"><%= row.kategori %></span>
                                        <strong><%= row.judul %></strong>
                                        <span class="news-row__meta"><%= tanggalAdmin(row.tanggal) %> &middot; <%= row.penulis||'Media Center HST' %></span>
                                    </span>
                                    <svg class="news-row__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>
                                </a>
                            <% } %>
                        </div>
                    <% } else { %>
                        <div class="empty-state">
                            <span class="empty-state__icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h10l4 4v12H5z"/><path d="M15 4v5h4"/><path d="M8 13h8M8 16h6"/></svg>
                            </span>
                            <strong>Belum ada berita</strong>
                            <p>Mulai publikasikan informasi pertama Media Center HST.</p>
                            <a class="btn btn--primary" href="<%= adminBase %>/berita/tambah">Tambah Berita</a>
                        </div>
                    <% } %>
                </article>
            </section>

         

<script src="<%= baseUrl %>/assets/js/admin.js" defer></script>
</body>
</html>
