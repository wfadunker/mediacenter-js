<%
  const hstActive = typeof navActive === 'string' && navActive ? navActive : 'beranda';
  const hstQuery = typeof q === 'string' ? q : '';
  const navItem = (key, href, label) => `<li><a href="${href}"${hstActive === key ? ' aria-current="page"' : ''}>${label}</a></li>`;
%>
<header class="site-header">
  <div class="container site-header__bar">
    <a class="brand" href="<%= baseUrl %>/" aria-label="Media Center HST, ke beranda">
      <img src="<%= baseUrl %>/assets/img/logo-hst.png" alt="" width="44" height="48">
      <span class="brand__text">
        <span>Pemerintah Kabupaten</span>
        <strong>Hulu Sungai Tengah</strong>
        <em>Media Center</em>
      </span>
    </a>

    <div class="site-header__tools">
      <div class="clock" aria-label="Tanggal dan jam saat ini">
        <span data-clock-date><%= tanggalFull %></span>
        <strong data-clock-time><%= jamFull %></strong>
      </div>

      <button type="button" class="header-btn" data-theme-toggle aria-pressed="false">
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"/></svg>
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <span data-theme-label>Mode gelap</span>
      </button>

      <button type="button" class="header-btn nav-toggle" aria-expanded="false" aria-controls="site-nav">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        <span data-nav-label>Menu</span>
      </button>
    </div>
  </div>

  <nav id="site-nav" class="site-nav" aria-label="Navigasi utama">
    <div class="container site-nav__inner">
      <ul class="site-nav__links">
        <%- navItem('beranda', baseUrl + '/', 'Beranda') %>
        <%- navItem('berita', baseUrl + '/berita', 'Berita') %>
        <%- navItem('tentang', baseUrl + '/tentang', 'Tentang') %>
        <li><a href="https://www.hstkab.go.id/" target="_blank" rel="noopener noreferrer">Portal HST <span aria-hidden="true">↗</span><span class="sr-only"> (tab baru)</span></a></li>
      </ul>

      <form class="site-search" method="get" action="<%= baseUrl %>/berita" role="search">
        <label class="sr-only" for="site-search-input">Cari berita daerah</label>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
        <input id="site-search-input" type="search" name="q" maxlength="100" value="<%= hstQuery %>" placeholder="Cari berita daerah…" autocomplete="off">
      </form>
    </div>
  </nav>
</header>

<div class="banner container" aria-label="Banner Media Center Kabupaten Hulu Sungai Tengah">
  <div class="banner__frame">
    <picture>
      <source media="(max-width: 700px)" srcset="<%= baseUrl %>/assets/img/banner-hst-mobile-animasi.svg" type="image/svg+xml">
      <img src="<%= baseUrl %>/assets/img/banner-hst-panjang-animasi.svg"
           alt="Ilustrasi Media Center Kabupaten Hulu Sungai Tengah dan Pemerintah Daerah"
           width="1920" height="370" decoding="async" fetchpriority="high">
    </picture>
  </div>
</div>
