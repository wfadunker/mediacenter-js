<%- include('../partials/header') %>

<a href="#konten-utama" class="mc-skip-link">Lewati navigasi</a>
<%- include('../partials/public-brand') %>
<!-- Banner panjang: desain resmi full width, SVG animasi per lapisan -->
<style>
  .hst-banner-wide { padding: 10px clamp(10px, 1.5vw, 28px); background: #f8fbfd; }
  .hst-banner-wide, .hst-banner-wide * { box-sizing: border-box; }
  .hst-banner-wide__media {
    display: block; width: 100%; max-width: 1920px; margin: 0 auto;
    border: 1px solid rgba(11,46,79,.13); border-radius: 8px;
    overflow: hidden; background: #fff;
    box-shadow: 0 3px 14px rgba(11,46,79,.075);
  }
  .hst-banner-wide__media picture { display: block; width: 100%; }
  .hst-banner-wide__media img { display: block; width: 100%; height: auto; }
  @media(max-width:700px) {
    .hst-banner-wide { padding: 8px 10px; }
    .hst-banner-wide__media { border-radius: 7px; }
  }
</style>
<section class="hst-banner-wide" aria-label="Banner Media Center Kabupaten Hulu Sungai Tengah">
  <div class="hst-banner-wide__media">
    <picture>
      <source media="(max-width: 700px)"
              srcset="<%= baseUrl %>/assets/img/banner-hst-mobile-animasi.svg"
              type="image/svg+xml">
      <img src="<%= baseUrl %>/assets/img/banner-hst-panjang-animasi.svg"
           alt="Media Center Pemerintah Kabupaten Hulu Sungai Tengah. Ilustrasi burung enggang, panorama daerah, dan foto pimpinan pemerintah daerah."
           width="1920" height="370" decoding="async" fetchpriority="high">
    </picture>
  </div>
</section>

<%- include('../partials/public-nav') %>

<%
  // Data berasal dari route beranda di server.js.
  const beritaUtama = typeof utama !== 'undefined' ? utama : null;
  const beritaTerbaru = typeof updates !== 'undefined' && Array.isArray(updates) ? updates : [];
%>

<main id="konten-utama" class="gov-home" tabindex="-1">
  <!-- BERITA UTAMA: FOTO DAN TEKS -->
  <section class="gov-home-section" aria-labelledby="berita-utama-title">
    <div class="gov-home-shell">
      <div class="gov-home-section-head">
        <div>
          <p class="gov-home-kicker">Media Center Kabupaten Hulu Sungai Tengah</p>
          <h2 id="berita-utama-title">Sorotan Daerah</h2>
        </div>
        <a href="<%= baseUrl %>/berita" class="gov-home-link">
          Lihat semua berita <span aria-hidden="true">→</span>
        </a>
      </div>

      <% if (beritaUtama) { %>
        <% const featuredUrl = detailUrl(beritaUtama.slug); %>
        <% const featuredImg = gambarUrl(beritaUtama.gambar); %>
        <article class="gov-home-featured">
          <a href="<%= featuredUrl %>" class="gov-home-featured-media"
             aria-label="Baca berita: <%= beritaUtama.judul %>">
            <% if (featuredImg) { %>
              <img src="<%= featuredImg %>" alt="Dokumentasi: <%= beritaUtama.judul %>"
                   width="900" height="620" decoding="async" fetchpriority="high">
            <% } else { %>
              <%- placeholderHome %>
            <% } %>
          </a>
          <div class="gov-home-featured-content">
            <div class="gov-home-meta">
              <span><%= beritaUtama.kategori || 'Informasi' %></span>
              <time datetime="<%= dateSql(beritaUtama.tanggal) %>">
                <%= tanggalBerita(beritaUtama.tanggal) %>
              </time>
            </div>
            <h2><a href="<%= featuredUrl %>"><%= beritaUtama.judul %></a></h2>
            <p><%= excerpt(beritaUtama.isi, 180) %></p>
            <a href="<%= featuredUrl %>" class="gov-home-read">
              Baca selengkapnya <span aria-hidden="true">→</span>
            </a>
          </div>
        </article>
      <% } else { %>
        <div class="mc-empty">
          <strong>Berita utama belum tersedia</strong>
          <p>Publikasi akan ditampilkan setelah administrator menambahkan berita.</p>
        </div>
      <% } %>
    </div>
  </section>

  <!-- BERITA TERBARU -->
  <section class="gov-home-section is-soft" aria-labelledby="berita-terbaru-title">
    <div class="gov-home-shell">
      <div class="gov-home-section-head">
        <div>
          <p class="gov-home-kicker">Publikasi Terbaru</p>
          <h2 id="berita-terbaru-title">Informasi Daerah</h2>
        </div>
        <a href="<%= baseUrl %>/berita" class="gov-home-link">
          Seluruh berita <span aria-hidden="true">→</span>
        </a>
      </div>

      <% if (beritaTerbaru.length) { %>
        <div class="gov-home-news-grid">
          <% for (const row of beritaTerbaru) { %>
            <% const newsUrl = detailUrl(row.slug); %>
            <% const newsImg = gambarUrl(row.gambar); %>
            <article class="gov-home-card">
              <a href="<%= newsUrl %>" class="gov-home-card-media"
                 aria-label="Baca berita: <%= row.judul %>">
                <% if (newsImg) { %>
                  <img src="<%= newsImg %>" alt="Dokumentasi: <%= row.judul %>"
                       width="640" height="400" loading="lazy" decoding="async">
                <% } else { %>
                  <%- placeholderHome %>
                <% } %>
              </a>
              <div class="gov-home-card-body">
                <div class="gov-home-meta">
                  <span><%= row.kategori || 'Informasi' %></span>
                  <time datetime="<%= dateSql(row.tanggal) %>">
                    <%= tanggalBerita(row.tanggal) %>
                  </time>
                </div>
                <h3><a href="<%= newsUrl %>"><%= row.judul %></a></h3>
                <p><%= excerpt(row.isi, 110) %></p>
                <a href="<%= newsUrl %>" class="gov-home-card-link">
                  Baca informasi <span aria-hidden="true">→</span>
                </a>
              </div>
            </article>
          <% } %>
        </div>
      <% } else { %>
        <div class="mc-empty">
          <strong>Belum ada publikasi terbaru</strong>
          <p>Silakan kunjungi kembali setelah ada berita diterbitkan.</p>
        </div>
      <% } %>
    </div>
  </section>

  <!-- AKSES KATEGORI -->
  <section class="gov-home-section" aria-labelledby="akses-title">
    <div class="gov-home-shell gov-home-access-layout">
      <div class="gov-home-access-copy">
        <p class="gov-home-kicker">Akses Informasi</p>
        <h2 id="akses-title">Temukan informasi sesuai kebutuhan</h2>
        <p>Pilih kategori atau gunakan fitur pencarian untuk menemukan informasi daerah.</p>
        <a href="<%= baseUrl %>/berita" class="gov-home-link">
          Buka arsip berita <span aria-hidden="true">→</span>
        </a>
      </div>
      <div class="gov-home-access-list">
        <%
          const access = [
            ['01', 'Pemerintahan', 'Agenda, kebijakan, dan kegiatan daerah.'],
            ['02', 'Pelayanan Publik', 'Informasi layanan untuk masyarakat.'],
            ['03', 'Pendidikan', 'Program dan kegiatan pendidikan.'],
            ['04', 'Sosial', 'Kegiatan sosial dan kemasyarakatan.']
          ];
        %>
        <% for (const [no, category, description] of access) { %>
          <a href="<%= kategoriUrl(category) %>">
            <span><%= no %></span>
            <div>
              <strong><%= category %></strong>
              <p><%= description %></p>
            </div>
            <b aria-hidden="true">→</b>
          </a>
        <% } %>
      </div>
    </div>
  </section>

  <!-- PORTAL PEMERINTAH DAERAH -->
  <section class="gov-home-portal" aria-labelledby="portal-title">
    <div class="gov-home-portal-inner">
      <div>
        <p class="gov-home-kicker">Kanal Pemerintah Daerah</p>
        <h2 id="portal-title">Portal Pemerintah Kabupaten Hulu Sungai Tengah</h2>
        <p>Akses informasi pemerintahan dan layanan publik lainnya melalui portal pemerintah daerah.</p>
      </div>
      <a class="mc-btn-primary" href="https://www.hstkab.go.id/"
         target="_blank" rel="noopener noreferrer">
        Kunjungi Portal Resmi <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</main>

<%- include('../partials/home-air-toast') %>
<%- include('../partials/footer') %>
