<section class="mc-banner" aria-label="Banner Media Center Kabupaten Hulu Sungai Tengah">
  <div class="mc-banner__inner">
    <picture class="mc-banner__media">
      <source
        media="(max-width: 720px)"
        srcset="<%= baseUrl %>/assets/img/banner-hst-mobile-animasi.svg"
        type="image/svg+xml"
      >
      <img
        src="<%= baseUrl %>/assets/img/banner-hst-panjang-animasi.svg"
        alt="Media Center Pemerintah Kabupaten Hulu Sungai Tengah. Ilustrasi burung enggang, panorama daerah, dan foto pimpinan pemerintah daerah."
        width="1920"
        height="370"
        fetchpriority="high"
        decoding="async"
      >
    </picture>
    <span class="mc-banner__tag">
      <span class="mc-banner__dot" aria-hidden="true"></span>
      Kanal Informasi Resmi
    </span>
  </div>
</section>
