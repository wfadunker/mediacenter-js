<%
  const hstActive = typeof navActive === 'string' && navActive ? navActive : 'beranda';
  const hstQuery = typeof q === 'string' ? q : '';
  const hstPortal = typeof portalUrl === 'string' && portalUrl ? portalUrl : 'https://www.hstkab.go.id/';
  const hstNav = [
    { key: 'beranda', href: baseUrl + '/', label: 'Beranda' },
    { key: 'berita', href: baseUrl + '/berita', label: 'Berita' },
    { key: 'tentang', href: baseUrl + '/tentang', label: 'Tentang' }
  ];
%>

<header class="mc-navbar">
  <div class="mc-navbar__inner">

    <a class="mc-navbar__brand" href="<%= baseUrl %>/" aria-label="Media Center HST, ke beranda">
      <img
        class="mc-navbar__logo"
        src="<%= baseUrl %>/assets/img/logo-hst.png"
        alt=""
        width="44"
        height="44"
        decoding="async"
      >
      <span class="mc-navbar__brandtext">
        <span>Pemerintah Kabupaten</span>
        <strong>Hulu Sungai Tengah</strong>
        <em>Media Center</em>
      </span>
    </a>

    <nav class="mc-navbar__nav" aria-label="Navigasi utama">
      <ul class="mc-navbar__menu">
        <% for (const item of hstNav) { %>
          <li>
            <a
              href="<%= item.href %>"
              <% if (hstActive === item.key) { %>class="is-active" aria-current="page"<% } %>
            ><%= item.label %></a>
          </li>
        <% } %>
        <li>
          <a href="<%= hstPortal %>" target="_blank" rel="noopener noreferrer">
            Portal HST <span aria-hidden="true">↗</span>
          </a>
        </li>
      </ul>
    </nav>

    <button
      type="button"
      class="mc-navbar__theme a11y-theme-round"
      data-theme-toggle
      aria-pressed="false"
      aria-label="Aktifkan mode gelap"
      title="Aktifkan mode gelap"
    >
      <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"/></svg>
      <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      <span class="a11y-visually-hidden" data-theme-label>Mode gelap</span>
    </button>

    <form class="mc-navbar__search" action="<%= baseUrl %>/berita" method="get" role="search">
      <label class="sr-only" for="mc-navbar-search">Cari berita daerah</label>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m20 20-4-4"></path>
      </svg>
      <input
        id="mc-navbar-search"
        type="search"
        name="q"
        maxlength="100"
        value="<%= hstQuery %>"
        placeholder="Cari berita…"
        autocomplete="off"
      >
    </form>

    <div class="mc-navbar__meta">
      <div class="mc-navbar__clock" aria-label="Tanggal dan jam saat ini">
        <span><%= tanggalFull %></span>
        <strong class="js-mc-nav-clock"><%= jamFull %></strong>
      </div>
      <span class="mc-navbar__status">
        <span class="mc-navbar__dot" aria-hidden="true"></span>
        Kanal Resmi
      </span>
    </div>

  </div>
</header>

<script>
(() => {
  const clock = document.querySelector('.js-mc-nav-clock');
  if (!clock) return;

  const formatter = new Intl.DateTimeFormat('id-ID', {
    timeZone: 'Asia/Makassar',
    hour: '2-digit',
    minute: '2-digit',
    second: '2-digit',
    hour12: false
  });

  const updateClock = () => {
    const parts = formatter.formatToParts(new Date());
    let hour = '';
    let minute = '';
    let second = '';

    for (const part of parts) {
      if (part.type === 'hour') hour = part.value;
      if (part.type === 'minute') minute = part.value;
      if (part.type === 'second') second = part.value;
    }

    clock.textContent = `${hour}.${minute}.${second} WITA`;
  };

  updateClock();
  window.setInterval(updateClock, 1000);
})();
</script>

<script>
(() => {
  const navbar = document.querySelector('.mc-navbar');
  if (!navbar) return;

  let shrunk = navbar.classList.contains('is-shrunk');
  let ticking = false;

  const update = () => {
    ticking = false;
    const y = window.scrollY || window.pageYOffset || document.documentElement.scrollTop || 0;

    if (!shrunk && y > 32) {
      shrunk = true;
      navbar.classList.add('is-shrunk');
    } else if (shrunk && y < 12) {
      shrunk = false;
      navbar.classList.remove('is-shrunk');
    }
  };

  const onScroll = () => {
    if (ticking) return;
    ticking = true;
    window.requestAnimationFrame(update);
  };

  update();
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll, { passive: true });
})();
</script>
