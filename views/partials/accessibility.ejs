<script>
(function () {
  try {
    var saved = window.localStorage.getItem('mc-theme');
    if (saved !== 'light' && saved !== 'dark') {
      saved = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    }
    document.documentElement.setAttribute('data-theme', saved);
  } catch (error) {
    // Preferensi sistem tetap dipakai bila penyimpanan diblokir.
  }
})();
</script>

<a class="a11y-skip-link" href="#main-content">Lewati ke konten utama</a>

