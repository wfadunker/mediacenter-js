<header class="topbar">
    <button type="button" class="topbar__menu" data-sidebar-open aria-expanded="false" aria-controls="admin-sidebar">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        <span class="sr-only">Buka menu navigasi</span>
    </button>

    <form class="topbar__search" method="get" action="<%= adminBase %>/berita" role="search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
        <label class="sr-only" for="admin-search">Cari berita</label>
        <input id="admin-search" type="search" name="q" maxlength="100" value="<%= typeof q==='string'?q:'' %>" placeholder="Cari berita, kategori, atau penulis...">
    </form>

    <div class="topbar__actions">
        <a class="topbar__link" href="<%= baseUrl %>/" target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3c3 3 3 15 0 18"/></svg>
            <span>Lihat Website</span>
        </a>
        <div class="topbar__user">
            <span class="avatar" aria-hidden="true"><%= initial %></span>
            <span class="topbar__user-text">
                <strong><%= username %></strong>
                <span>Administrator</span>
            </span>
        </div>
    </div>
</header>
